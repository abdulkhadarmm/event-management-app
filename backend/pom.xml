<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <!-- 
            Spring Boot Starter Parent provides dependency management, default plugin configurations,
            and sensible build defaults for Spring Boot applications.
            Solves: Avoids explicit version management for transitive Spring Boot dependencies.
        -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.eventeasy</groupId>
    <artifactId>event-management-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>EventEasy Backend Foundation</name>
    <description>Enterprise Event Management SaaS Application Backend - Phase 1 Foundation</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- 
            Spring Boot Web Starter:
            Provides RESTful web services capabilities using Spring MVC, embedded Tomcat web server, and Jackson JSON serializer.
            Solves: Enables HTTP request handling, endpoint mapping, request/response JSON serialization, and web container execution.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 
            Spring Boot Data JPA Starter:
            Integrates Spring Data, Hibernate ORM, and Jakarta Persistence for relational database operations.
            Solves: Eliminates repetitive JDBC boilerplate code, provides repository abstraction, and enables object-relational mapping.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 
            Spring Boot Security Starter:
            Provides authentication, authorization, role-based access control (RBAC), and security hardening features.
            Solves: Protects REST APIs against unauthorized access, enforces password encoding, and supports stateless authentication.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 
            Spring Boot Validation Starter:
            Includes Jakarta Bean Validation (Hibernate Validator) for validating request DTO payloads.
            Solves: Prevents invalid or malformed incoming HTTP request data from reaching business service layers.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 
            MySQL Connector/J:
            Official JDBC driver for connecting Java applications to MySQL relational databases.
            Solves: Enables high-performance, secure communication and transaction handling between Spring Data JPA and MySQL 8.x instances.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            JJWT API (Java JWT):
            Defines interfaces and constants for JSON Web Token (JWT) creation, parsing, and signing.
            Solves: Enables secure claims-based, stateless authentication tokens for REST clients.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <!-- 
            JJWT Implementation:
            Provides runtime implementation of the JJWT API specification.
            Solves: Performs cryptographic signature verification (HMAC-SHA512) and payload encoding/decoding.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            JJWT Jackson Integration:
            Deserializes and serializes JWT JSON payloads using Jackson ObjectMapper.
            Solves: Converts token claims cleanly to and from Java objects without manual JSON parsing.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            Project Lombok:
            Automates boilerplate Java code generation such as getters, setters, constructors, builders, and equals/hashCode.
            Solves: Keeps domain entities, DTOs, and component classes clean, concise, and readable.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 
            SpringDoc OpenAPI Starter WebMVC UI:
            Generates interactive OpenAPI 3.0 (Swagger UI) documentation for public and protected REST API endpoints.
            Solves: Provides visual API documentation, live endpoint testing, and contract discovery for frontend developers.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 
            Spring Boot DevTools:
            Provides fast application restart, live reload, and enhanced developer ergonomics during local development.
            Solves: Accelerates dev feedback loops by automatically reloading modified classes upon compilation.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 
            Spring Boot Test Starter:
            Includes JUnit 5, AssertJ, Mockito, and Spring Test framework modules for unit and integration testing.
            Solves: Facilitates automated testing of service logic, repository queries, and web endpoints.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 
            Spring Security Test:
            Provides test utilities, security mock contexts, and custom security annotations for Spring Security testing.
            Solves: Allows testing protected REST APIs with mocked authenticated user principals and role permissions.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 
                Spring Boot Maven Plugin:
                Packages the application into an executable fat JAR with embedded Tomcat dependencies.
                Solves: Simplifies application deployment to cloud environments like Render or Docker containers.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 
                Maven Compiler Plugin:
                Configures Java version source and target compilation parameters for Java 21 features.
                Solves: Ensures clean compilation with target JDK version and strict compiler flags.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
